---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import SectionHead from '../components/site/SectionHead.astro';
import QuestionBalloon from '../components/site/QuestionBalloon.astro';
import PriceSimulator from '../components/site/PriceSimulator.astro';
import TargetTabs from '../components/site/TargetTabs.astro';

// 4セクション構成（2026-08-14 再々設計）: 授業料（こだわり先行）→ 諸経費 → その他オプション → お手頃価格のワケ
// 前半=料金の全貌（必ずかかるもの→任意のもの）・後半=評価（なぜ安いか）の2部構成。
// 他塾比較セクションは2026-08-14に削除（比較データの根拠管理が料金ページでは不要に）
// レイアウトは /method と同型（吹き出し直後にセクション・交互背景・方眼ノートカードに本文＋図解）
// 教科数ごとの月額 = 1教科 6,578円（税込）・月4回授業の単純合算が実料金。同一教科の複数枠受講も可（枠数分の料金）。計算は PriceSimulator が担う

// オプション（料金は掲載しない。すべて任意であることを本文で明記）。名前タップで説明が開く（FAQと同じ排他アコーディオン）
// 説明文は2026-08-14にユーザー確認済み（外部模試=Sもぎ）
const options = [
  { name: '定期テスト対策', desc: '学校の定期テストの前に、テスト範囲に合わせた対策授業を追加できる講座です。' },
  { name: '過去問演習講座', desc: '高校入試の過去問を実戦形式で解き、時間配分と得点力を鍛える講座です。' },
  { name: '外部模試', desc: '偏差値や志望校の合格判定を確認できる、外部の模擬試験（Sもぎ）です。' },
];
---
<SiteLayout
  title="料金｜学習塾フォーカス"
  description="学習塾フォーカスの料金。1教科あたり月6,578円（税込）で5教科どれでも同じ料金。入会金・設備管理費0円、授業料は中学3年間据え置きの明朗会計です。"
>
  <PageHero eyebrow="PRICE" title="料金" deco="price" />

  {/* ページの導入となる問い（現行サイトの見出しを踏襲。以降のセクションが答える構造） */}
  <QuestionBalloon text="個別指導って、高いんじゃないの？" />

  {/* ===== 授業料 ===== */}
  <section class="sec alt">
    <div class="container">
      <SectionHead eyebrow="TUITION" title="授業料" />
      <div class="note-card">
        {/* こだわり（Why）を先に語ってから金額へ。マーカーはカード内1箇所=金額に */}
        <p class="body-p">個別指導は料金が高く、受講は1〜2教科に絞るもの──フォーカスは、その「当たり前」をなくしたいと考えています。5教科すべての受講も、苦手科目を週2回受講することもあきらめなくていい料金にこだわりました。</p>
        {/* 月4回の説明はシミュレータの式（6,578円×n教科（月4n回））が担うため本文からは省く */}
        <p class="body-p">フォーカスの授業料は、<span class="mk">1教科あたり月6,578円（税込）</span>です。複雑な料金プランはなく、選んだ教科数分の単純なかけ算だけの明朗会計です。</p>
        <PriceSimulator />
        {/* 季節講習は存在の告知のみ（費用・原則参加の記載はユーザー判断で載せない） */}
        <p class="body-p seasonal">また、春・夏・冬の年3回は、通常授業に加えて季節講習を実施しています。</p>
      </div>
    </div>
  </section>

  {/* ===== 諸経費 ===== */}
  <section class="sec">
    <div class="container">
      <SectionHead eyebrow="FEES" title="諸経費" />
      <div class="note-card">
        <p class="body-p">塾には、授業料のほかにも何かとお金がかかるものです。入会金、設備管理費、教材費、模試代…。フォーカスでは、授業料のほかに毎月、<span class="mk">教材費・システム利用料の1,375円（税込）のみ</span>いただいています。入会金・設備管理費は0円で、学年による授業料の値上げなども一切ありません。</p>

        {/* 積み上げくらべ: 授業料の上に諸経費が積み上がる一般的な塾 vs ほぼ授業料だけのフォーカス。
            ◯側は「必ずかかるのは」の言い回しで任意オプション（季節講習等）の存在と両立させる（詳細はその他オプションで） */}
        <div class="stk">
          <div class="stk-col">
            <p class="stk-cap">授業料のほかにも<br />いろいろかかる</p>
            {/* 重さの表現: 詰まった段間隔・強めの傾き・圧のシワ線・たわむ地面
                （授業料ブロックのつぶし表現は「フォーカスの方が授業料が高く見える」ため不採用） */}
            {/* ✗側は「他塾で毎月かかるのが一般的な費目」のみで構成（◯側の「毎月かかるのは」と対比を揃える）。
                入会金・模試代（毎月でない）と季節講習費（フォーカスも原則参加）は載せない */}
            <div class="tower ng">
              <div class="blk o1" style="background:#9AA8BB">システム管理費</div>
              <div class="blk o2" style="background:#8E9DB1">冷暖房費</div>
              <div class="blk o3" style="background:#9AA8BB">教材費</div>
              <div class="blk" style="background:#8493A8">設備管理費</div>
              <div class="blk base press" style="background:#76859B">授業料</div>
            </div>
            <svg class="stk-ground" viewBox="0 0 150 10" aria-hidden="true"><path d="M2 3 Q75 10 148 3" fill="none" stroke="#B9C8DE" stroke-width="3" stroke-linecap="round"></path></svg>
            <p class="stk-name">一般的な塾</p>
          </div>
          <div class="stk-div" aria-hidden="true"></div>
          <div class="stk-col">
            <p class="stk-cap ok">毎月かかるのは<br />これだけ！</p>
            <div class="tower">
              <div class="blk" style="background:var(--navy-light)">教材費など <small>1,375円</small></div>
              <div class="blk base" style="background:var(--navy)">授業料</div>
            </div>
            <svg class="stk-ground" viewBox="0 0 150 10" aria-hidden="true"><path d="M2 3 L148 3" fill="none" stroke="#B9C8DE" stroke-width="3" stroke-linecap="round"></path></svg>
            <p class="stk-name ok">フォーカス</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== その他オプション（すべて任意であることを必ず明記。諸経費の「必ずかかるのは」を受けて任意分を開示） ===== */}
  <section class="sec alt">
    <div class="container">
      <SectionHead eyebrow="OPTIONS" title="その他オプション" />
      <div class="note-card">
        <p class="body-p">上記のほかに、オプション講座もご用意していますが、<span class="mk">受講はすべて任意です。</span>必要なものを必要な分だけ、保護者さまご自身で都度お選びいただけます。</p>
        <ul class="opt-list" data-opt-acc>
          {options.map((o) => (
            <li class="opt-item">
              <button type="button" class="opt-head" aria-expanded="false" data-opt-toggle>
                <span class="opt-add" aria-hidden="true">＋</span>
                <span class="opt-name">{o.name}</span>
                <span class="opt-tag">任意</span>
              </button>
              <div class="opt-body"><div class="opt-clip"><p>{o.desc}</p></div></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ===== お手頃価格が実現できるワケ ===== */}
  <section class="sec">
    <div class="container">
      <SectionHead eyebrow="WHY" title="お手頃価格が実現できるワケ" />
      <div class="note-card">
        {/* Q→Aの流れ: なぜこの価格が実現できるのか？→ターゲットを絞っているから */}
        <p class="body-p">なぜ、この価格が実現できるのか──答えは、対象を<span class="mk">勉強が苦手な中学生だけに絞っている</span>からです。全学年・全レベルに対応しようとすれば、設備も教材も、人件費も研修コストもふくらみます。フォーカスは対象を絞ることでムダな費用をなくし、そのぶんを価格と授業の質に還元しています。</p>

        {/* 大勢の生徒→照準ロックの絞り込みをインデックスタブで切替（画面に入ると✗→◯を1回自動再生） */}
        <TargetTabs />
      </div>
    </div>
  </section>

  <CtaBand />
</SiteLayout>

<style>
  .container { max-width: 760px; margin: 0 auto; padding: clamp(44px, 6vw, 72px) 24px; }

  /* /method と同型: 交互背景 + 方眼ノートカード（本文 + 図解） */
  .sec { background: #fff; }
  .sec.alt { background: var(--alt-bg); }
  .note-card {
    background-color: #fff;
    background-image:
      linear-gradient(rgba(74, 122, 204, .10) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 122, 204, .10) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--line); border-radius: 16px; padding: clamp(20px, 3.5vw, 32px);
    box-shadow: 0 1px 2px rgba(20, 42, 84, .06), 0 12px 24px rgba(20, 42, 84, .06);
  }
  .body-p { font-size: 15px; line-height: 2.15; color: var(--ink); margin: 0 auto 16px; max-width: 640px; }
  .body-p.seasonal { margin: 20px auto 0; }

  /* 諸経費: 積み上げくらべ（上=説明タイトル / 下=塾名） */
  .stk { display: flex; justify-content: center; align-items: flex-end; gap: clamp(16px, 3.5vw, 26px); }
  /* 他塾とフォーカスを分ける縦の点線 */
  .stk-div { align-self: stretch; width: 0; border-left: 2px dashed #C9D3E0; margin-top: 4px; }
  .stk-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  .stk-cap { font-family: var(--font-round); font-size: 14px; font-weight: 800; color: var(--muted); margin: 0 0 10px; line-height: 1.65; text-align: center; }
  .stk-cap.ok { color: var(--navy); }
  .tower { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 3px; }
  .blk {
    width: 130px; border-radius: 6px; color: #fff; display: flex; align-items: center; justify-content: center; gap: 4px;
    font: 800 12.5px var(--font-round); height: 28px;
  }
  .blk small { font-size: 12px; font-weight: 800; opacity: 1; }
  .blk.base { height: 48px; font-size: 14px; }
  .blk.o1 { transform: translateX(7px) rotate(-2.2deg); }
  .blk.o2 { transform: translateX(-6px) rotate(1.6deg); }
  .blk.o3 { transform: translateX(4px) rotate(-1.2deg); }
  .blk.o4 { transform: translateX(-4px) rotate(.8deg); }
  /* 重さの表現（✗側のみ） */
  .tower.ng { gap: 2px; }
  .blk.press { position: relative; }
  .blk.press::before, .blk.press::after {
    content: ""; position: absolute; bottom: 5px; width: 13px; height: 2.5px; border-radius: 2px; background: #9AA5B5;
  }
  .blk.press::before { left: -18px; transform: rotate(34deg); box-shadow: 6px -9px 0 #B7C1CE; }
  .blk.press::after { right: -18px; transform: rotate(-34deg); box-shadow: -6px -9px 0 #B7C1CE; }
  /* 地面は両側ともSVG（同一ジオメトリ）: ✗側だけ地面レベルから下にたわむ */
  .stk-ground { width: 150px; height: 10px; display: block; }
  .stk-name { font-size: 14px; font-weight: 800; color: var(--muted); margin: 9px 0 0; text-align: center; }
  .stk-name.ok { color: var(--navy); font-weight: 900; }


  /* その他オプション（タップで説明が開く。開閉機構はFaqListと同じ grid-template-rows 0fr→1fr）
     オプション感の演出: 点線枠=まだ足していない任意のもの（開くと実線紺枠）・＋丸バッジ=追加できるもの（開くと×に回転）・任意ピル */
  .opt-list { list-style: none; margin: 0 auto; padding: 0; max-width: 480px; display: flex; flex-direction: column; gap: 10px; }
  .opt-item {
    background: #fff; border: 1.5px dashed #A9BBD4; border-radius: 12px;
    overflow: hidden; transition: border-color .2s ease;
  }
  .opt-item.open { border: 1.5px solid var(--navy); }
  .opt-head {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 13px 16px;
    background: none; border: none; text-align: left; cursor: pointer;
    font-family: var(--font-body); font-size: 15px; font-weight: 700; color: var(--ink);
  }
  .opt-add {
    flex: none; width: 26px; height: 26px; border-radius: 50%;
    background: #E3ECFB; color: var(--navy); font: 900 15px var(--font-round);
    display: grid; place-items: center; transition: transform .3s;
  }
  .opt-item.open .opt-add { transform: rotate(45deg); }
  .opt-name { flex: 1; }
  .opt-tag {
    flex: none; font: 800 11.5px var(--font-round); color: var(--muted);
    border: 1.5px solid #C6D0DC; border-radius: 999px; padding: 3px 10px;
  }
  .opt-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .opt-item.open .opt-body { grid-template-rows: 1fr; }
  .opt-clip { overflow: hidden; }
  .opt-body p { font-size: 14.5px; line-height: 1.95; color: var(--ink); margin: 0; padding: 0 16px 14px 52px; }
</style>

<script>
  // オプションの説明を開閉（FAQと同じ排他式: 1つ開くと他は閉じる）
  const items = [...document.querySelectorAll<HTMLElement>('[data-opt-acc] .opt-item')].filter(
    (it) => it.querySelector('[data-opt-toggle]'),
  );
  items.forEach((item) => {
    item.querySelector('[data-opt-toggle]')?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('open');
      items.forEach((it) => {
        const open = it === item && willOpen;
        it.classList.toggle('open', open);
        it.querySelector('[data-opt-toggle]')?.setAttribute('aria-expanded', String(open));
      });
    });
  });
</script>
