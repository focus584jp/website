---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import SectionHead from '../components/site/SectionHead.astro';
import QuestionBalloon from '../components/site/QuestionBalloon.astro';
import PriceSimulator from '../components/site/PriceSimulator.astro';

// 4セクション構成（2026-08-14 再々設計）: 授業料（こだわり先行）→ 諸経費 → その他オプション → お手頃価格のワケ
// 前半=料金の全貌（必ずかかるもの→任意のもの）・後半=評価（なぜ安いか）の2部構成。
// 他塾比較セクションは2026-08-14に削除（比較データの根拠管理が料金ページでは不要に）
// レイアウトは /method と同型（吹き出し直後にセクション・交互背景・方眼ノートカードに本文＋図解）
// 教科数ごとの月額 = 1教科 6,578円（税込）・月4回授業の単純合算が実料金。同一教科の複数枠受講も可（枠数分の料金）。計算は PriceSimulator が担う

// オプション（料金は掲載しない。すべて任意であることを本文で明記）
const options = ['定期テスト対策', '過去問演習講座', '外部模試'];
---
<SiteLayout
  title="料金｜学習塾フォーカス"
  description="学習塾フォーカスの料金。1教科あたり月6,578円（税込）で5教科どれでも同じ料金。入会金・設備管理費0円、授業料は中学3年間据え置きの明朗会計です。"
>
  <PageHero eyebrow="PRICE" title="料金" deco="price" />

  {/* ページの導入となる問い（現行サイトの見出しを踏襲。以降のセクションが答える構造） */}
  <QuestionBalloon text="個別指導って、高いんじゃないの？" />

  {/* ===== 授業料 ===== */}
  <section class="sec alt">
    <div class="container">
      <SectionHead eyebrow="TUITION" title="授業料" />
      <div class="note-card">
        {/* こだわり（Why）を先に語ってから金額へ。マーカーはカード内1箇所=金額に */}
        <p class="body-p">個別指導は料金が高く、受講は1〜2教科に絞るもの──フォーカスは、その「当たり前」をなくしたいと考えています。5教科すべての受講も、苦手科目を週2回受講することもあきらめなくていい料金にこだわりました。</p>
        {/* 月4回の説明はシミュレータの式（6,578円×n教科（月4n回））が担うため本文からは省く */}
        <p class="body-p">フォーカスの授業料は、<span class="mk">1教科あたり月6,578円（税込）</span>です。複雑な料金プランはなく、選んだ教科数分の単純なかけ算だけの明朗会計です。</p>
        <PriceSimulator />
      </div>
    </div>
  </section>

  {/* ===== 諸経費 ===== */}
  <section class="sec">
    <div class="container">
      <SectionHead eyebrow="FEES" title="諸経費" />
      <div class="note-card">
        <p class="body-p">塾には、授業料のほかにも何かとお金がかかるものです。入会金、設備管理費、教材費、季節講習費…。フォーカスでは、授業料のほかに毎月、<span class="mk">教材費・システム利用料の1,375円（税込）のみ</span>いただいています。入会金・設備管理費は0円で、学年による授業料の値上げなども一切ありません。</p>

        {/* 積み上げくらべ: 授業料の上に諸経費が積み上がる一般的な塾 vs ほぼ授業料だけのフォーカス。
            ◯側は「必ずかかるのは」の言い回しで任意オプション（季節講習等）の存在と両立させる（詳細はその他オプションで） */}
        <div class="stk">
          <div class="stk-col">
            <p class="stk-cap">授業料のほかにも<br />いろいろかかる</p>
            {/* 重さの表現: 詰まった段間隔・強めの傾き・圧のシワ線・たわむ地面
                （授業料ブロックのつぶし表現は「フォーカスの方が授業料が高く見える」ため不採用） */}
            <div class="tower ng">
              <div class="blk o1" style="background:#B7C1CE">模試代</div>
              <div class="blk o2" style="background:#A5AFBE">季節講習費</div>
              <div class="blk o3" style="background:#B7C1CE">教材費</div>
              <div class="blk o4" style="background:#A5AFBE">設備管理費</div>
              <div class="blk" style="background:#9AA5B5">入会金</div>
              <div class="blk base press" style="background:#8A96A8">授業料</div>
            </div>
            <svg class="stk-ground" viewBox="0 0 150 10" aria-hidden="true"><path d="M2 3 Q75 10 148 3" fill="none" stroke="#B9C8DE" stroke-width="3" stroke-linecap="round"></path></svg>
            <p class="stk-name">一般的な塾</p>
          </div>
          <div class="stk-col">
            <p class="stk-cap ok">必ずかかるものは<br />これだけ！</p>
            <div class="tower">
              <div class="blk" style="background:var(--navy-light)">教材費など <small>1,375円</small></div>
              <div class="blk base" style="background:var(--navy)">授業料</div>
            </div>
            <svg class="stk-ground" viewBox="0 0 150 10" aria-hidden="true"><path d="M2 3 L148 3" fill="none" stroke="#B9C8DE" stroke-width="3" stroke-linecap="round"></path></svg>
            <p class="stk-name ok">フォーカス</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== その他オプション（すべて任意であることを必ず明記。諸経費の「必ずかかるのは」を受けて任意分を開示） ===== */}
  <section class="sec alt">
    <div class="container">
      <SectionHead eyebrow="OPTIONS" title="その他オプション" />
      <div class="note-card">
        <p class="body-p">必ずかかる費用は、以上ですべてです。このほかに、ご希望に応じて選べるオプション講座があります。<span class="mk">オプションはすべて任意です。</span>選ぶ際のアドバイスはいたしますが、必要なサービスを必要な分だけ、保護者さまご自身で都度お選びいただけます。</p>
        <ul class="opt-list">
          {options.map((o) => (
            <li class="opt-item">
              <span class="opt-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#143778" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l6 6L20 6"></path></svg></span>
              {o}
            </li>
          ))}
          <li class="opt-item etc">など</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ===== お手頃価格が実現できるワケ ===== */}
  <section class="sec">
    <div class="container">
      <SectionHead eyebrow="WHY" title="お手頃価格が実現できるワケ" />
      <div class="note-card">
        <p class="body-p">一般的な個別指導塾は、正直、高いです。フォーカスは<span class="mk">勉強が苦手な中学生に絞る</span>ことでムダな費用を抑え、それでいて高い授業品質を保っています。</p>

        {/* 対比図: あれもこれもの塾 vs 対象を絞るフォーカス */}
        <div class="why-fig">
          <div class="wf-panels">
            <div class="wf-panel ng">
              <p class="wf-head"><span class="m ng"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#C0392B" stroke-width="3.2" stroke-linecap="round"><path d="M5 5l14 14"></path><path d="M19 5L5 19"></path></svg></span>一般的な塾</p>
              <svg viewBox="0 0 170 110" role="img" aria-label="全学年・全レベルに対応する一般的な塾">
                <g fill="#9AA5B5">
                  <g transform="translate(30,30) scale(.6)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
                  <g transform="translate(62,24) scale(.85)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
                  <g transform="translate(102,28) scale(.72)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
                  <g transform="translate(138,22) scale(.95)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
                </g>
                <text x="30" y="88" text-anchor="middle" font-size="10" font-weight="700" fill="#5B6B85">小学生</text>
                <text x="63" y="88" text-anchor="middle" font-size="10" font-weight="700" fill="#5B6B85">中学生</text>
                <text x="102" y="88" text-anchor="middle" font-size="10" font-weight="700" fill="#5B6B85">高校生</text>
                <text x="139" y="88" text-anchor="middle" font-size="10" font-weight="700" fill="#5B6B85">受験生</text>
                <text x="85" y="105" text-anchor="middle" font-size="10.5" font-weight="700" fill="#5B6B85">全学年・全レベルに対応</text>
              </svg>
              <p class="wf-cap">幅広く対応するため<br />設備・教材・人件費がかさむ</p>
            </div>
            <div class="wf-panel ok">
              <p class="wf-head"><span class="m ok"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#143778" stroke-width="3"><circle cx="12" cy="12" r="8.5"></circle></svg></span>フォーカス</p>
              <svg viewBox="0 0 170 110" role="img" aria-label="勉強が苦手な中学生だけに絞るフォーカス">
                <circle cx="85" cy="46" r="36" fill="none" stroke="#E67832" stroke-width="2.5" stroke-dasharray="6 5"></circle>
                <path d="M85 4 v12 M85 76 v12 M43 46 h12 M115 46 h12" stroke="#E67832" stroke-width="2.5" stroke-linecap="round"></path>
                <g fill="#143778">
                  <g transform="translate(70,26) scale(.78)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
                  <g transform="translate(100,26) scale(.78)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
                </g>
                <text x="85" y="105" text-anchor="middle" font-size="10.5" font-weight="800" fill="#143778">勉強が苦手な中学生だけ</text>
              </svg>
              <p class="wf-cap">対象を絞るから<br />ムダな費用がかからない</p>
            </div>
          </div>
          <p class="why-sum">絞っているから、<strong>安くて高品質</strong>。</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</SiteLayout>

<style>
  .container { max-width: 760px; margin: 0 auto; padding: clamp(44px, 6vw, 72px) 24px; }

  /* /method と同型: 交互背景 + 方眼ノートカード（本文 + 図解） */
  .sec { background: #fff; }
  .sec.alt { background: var(--alt-bg); }
  .note-card {
    background-color: #fff;
    background-image:
      linear-gradient(rgba(74, 122, 204, .10) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 122, 204, .10) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--line); border-radius: 16px; padding: clamp(20px, 3.5vw, 32px);
    box-shadow: 0 1px 2px rgba(20, 42, 84, .06), 0 12px 24px rgba(20, 42, 84, .06);
  }
  .body-p { font-size: 15px; line-height: 2.15; color: var(--ink); margin: 0 auto 16px; max-width: 640px; }

  /* 諸経費: 積み上げくらべ（上=説明タイトル / 下=塾名） */
  .stk { display: flex; justify-content: center; align-items: flex-end; gap: clamp(30px, 6vw, 48px); }
  .stk-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  .stk-cap { font-family: var(--font-round); font-size: 13px; font-weight: 800; color: var(--muted); margin: 0 0 10px; line-height: 1.65; text-align: center; }
  .stk-cap.ok { color: var(--navy); }
  .tower { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 3px; }
  .blk {
    width: 124px; border-radius: 6px; color: #fff; display: flex; align-items: center; justify-content: center; gap: 4px;
    font: 800 11.5px var(--font-round); height: 26px;
  }
  .blk small { font-size: 10px; font-weight: 700; opacity: .95; }
  .blk.base { height: 46px; font-size: 13px; }
  .blk.o1 { transform: translateX(7px) rotate(-2.2deg); }
  .blk.o2 { transform: translateX(-6px) rotate(1.6deg); }
  .blk.o3 { transform: translateX(4px) rotate(-1.2deg); }
  .blk.o4 { transform: translateX(-4px) rotate(.8deg); }
  /* 重さの表現（✗側のみ） */
  .tower.ng { gap: 2px; }
  .blk.press { position: relative; }
  .blk.press::before, .blk.press::after {
    content: ""; position: absolute; bottom: 5px; width: 13px; height: 2.5px; border-radius: 2px; background: #9AA5B5;
  }
  .blk.press::before { left: -18px; transform: rotate(34deg); box-shadow: 6px -9px 0 #B7C1CE; }
  .blk.press::after { right: -18px; transform: rotate(-34deg); box-shadow: -6px -9px 0 #B7C1CE; }
  /* 地面は両側ともSVG（同一ジオメトリ）: ✗側だけ地面レベルから下にたわむ */
  .stk-ground { width: 150px; height: 10px; display: block; }
  .stk-name { font-size: 13.5px; font-weight: 800; color: var(--muted); margin: 9px 0 0; text-align: center; }
  .stk-name.ok { color: var(--navy); font-weight: 900; }

  /* お手頃価格のワケ */
  .why-fig { max-width: 480px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
  .wf-panels { display: flex; gap: 10px; }
  .wf-panel { flex: 1; border-radius: 14px; padding: 14px 10px 16px; text-align: center; }
  .wf-panel.ng { background: #EEF1F5; }
  .wf-panel.ok { background: var(--blue-paler); border: 2px solid var(--navy); }
  .wf-head { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 13px; font-weight: 800; margin: 0 0 4px; }
  .wf-head .m { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; }
  .wf-head .m.ng { background: #FBE0E0; }
  .wf-head .m.ok { background: #E3ECFB; }
  .wf-panel.ng .wf-head { color: var(--ink); }
  .wf-panel.ok .wf-head { color: var(--navy); }
  .wf-panel svg { width: 100%; max-width: 170px; height: auto; display: block; margin: 4px auto 0; }
  .wf-cap { font-size: 12px; font-weight: 700; color: var(--muted); margin: 8px 0 0; line-height: 1.7; }
  .wf-panel.ok .wf-cap { color: var(--navy); }
  .why-sum { font-family: var(--font-round); font-size: 15.5px; font-weight: 800; color: var(--ink); text-align: center; margin: 4px 0 0; }

  /* その他オプション */
  .opt-list { list-style: none; margin: 0 auto; padding: 0; max-width: 480px; display: flex; flex-direction: column; gap: 10px; }
  .opt-item {
    display: flex; align-items: center; gap: 10px;
    background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-card);
    padding: 13px 16px; font-size: 15px; font-weight: 700; color: var(--ink);
  }
  .opt-item.etc { background: none; border: none; box-shadow: none; justify-content: center; color: var(--muted); font-size: 13.5px; padding: 0; }
  .opt-check {
    flex: none; width: 26px; height: 26px; border-radius: 50%;
    background: #E3ECFB; display: grid; place-items: center;
  }
</style>
