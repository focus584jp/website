---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import BeforeAfterSlider from '../components/site/BeforeAfterSlider.astro';
import RatioCycle from '../components/site/RatioCycle.astro';
import TeacherFilter from '../components/site/TeacherFilter.astro';
import { u } from '../lib/path';

// 4本柱構成（2026-08-13 現行サイト focus584.net/teaching/ を参考に再設計）。
// 役割: ①どこから（基礎）→②どう変わる（できた！）→③どう定着する（1対4）→④誰と（講師）
// 本文は各1段落・3文程度。強調（グローバル.mk黄マーカー）は1コンテンツ1箇所まで
const pillars = [
  {
    num: '01',
    id: 'learn-from-basics',
    title: '基礎から学び直す',
    body: [
      '一般的な塾では、学校の授業に沿って指導が行われます。フォーカスでは学年にとらわれず、<span class="mk">つまずいたところまで戻って</span>学習し直します。苦手の原因から積み直すので、授業についていけないという心配はありません。',
    ],
    fig: 'blocks' as const,
  },
  {
    num: '02',
    id: 'dekita',
    title: '「できた！」が増える授業',
    body: [
      'フォーカスの授業は、答えをすぐに教えません。考え方を問いかけ、ヒントを出しながら、<span class="mk">自分の力で「できた！」にたどり着かせます</span>。この積み重ねが自信になり、勉強への姿勢が変わっていきます。',
    ],
    fig: 'talk' as const,
  },
  {
    num: '03',
    // 1対4は見出しに出さないが、本文では「なぜ1対2でなく1対4か」の合理性（=演習時間の確保）を示す
    id: 'practice-and-coaching',
    title: '演習量をしっかり確保する',
    body: [
      'フォーカスの授業は、先生と解く「解説」と、自分の力で解く「演習」を行き来しながら進みます。先生がつきっきりの1対1や1対2の指導形式では、教わるだけの受け身になりがちです。フォーカスでは<span class="mk">演習量をしっかりと確保する</span>ため、最大1対4形式で指導を行っています。解いた分だけ定着し、自分で学習する力が身につきます。',
    ],
    fig: 'ratio' as const,
  },
  {
    num: '04',
    id: 'teachers',
    title: '選び抜かれた千葉大生講師陣',
    body: [
      'フォーカスの講師は、全員が千葉大学の学生です。それでも、応募者を全員採用するわけではありません。<span class="mk">勉強が苦手な子に寄り添えるか</span>を重視して選考し、採用するのは約30%です。',
    ],
    fig: 'teachers' as const,
  },
];
---
<SiteLayout
  title="指導方針｜学習塾フォーカス"
  description="学習塾フォーカスの指導方針。基礎からの学び直し、勉強のやり方が身につくCoaching指導、1対4の個別指導、選び抜かれた千葉大生講師陣で成績を上げます。"
>
  {/* リード文なし: 直下の「どのように成績が上がるの？」+4本柱概要が内容を視覚で伝えるため */}
  <PageHero eyebrow="METHOD" title="指導方針" />

  {/* ページの導入となる問い（目次リストは2026-08-13に削除: 流し見ペルソナには冗長で、直後に同じ見出しが並ぶため） */}
  <section class="overview">
    <div class="container">
      <h2 class="q-title">どのように成績が上がるの？</h2>
    </div>
  </section>

  {pillars.map((p, i) => (
    <section id={p.id} class:list={['pillar', { alt: i % 2 === 0 }]}>
      <div class="container">
        <div class="head">
          <span class="pillar-pill">POINT {p.num}</span>
          <h2>{p.title}</h2>
        </div>
        <div class="note-card">
          {p.body.map((t) => <p class="body-p" set:html={t} />)}
          {p.fig === 'blocks' && <BeforeAfterSlider variant="blocks" />}
          {p.fig === 'talk' && <BeforeAfterSlider variant="talk" />}
          {p.fig === 'ratio' && <RatioCycle />}
          {p.fig === 'teachers' && <TeacherFilter />}
        </div>
      </div>
    </section>
  ))}

  {/* 指導方針を読んだ人の次の関心は料金（現行サイト踏襲の導線） */}
  <section class="next">
    <div class="container next-c">
      <a href={u('/price')} class="btn-out">授業料を見る<span class="ar">→</span></a>
    </div>
  </section>

  <CtaBand />
</SiteLayout>

<style>
  .container { max-width: 860px; margin: 0 auto; padding: clamp(40px, 6vw, 64px) 24px; }

  /* 全体像 */
  .overview { background: #fff; }
  .overview .container { padding-top: clamp(32px, 5vw, 48px); padding-bottom: clamp(32px, 5vw, 48px); text-align: center; }
  /* 問いかけの見出し: 保護者の疑問を代弁する吹き出し（以降の4ポイントが答える構造）。
     白地+紺枠+紺文字+淡青のずらし影（ヒーローの専門タグと同じオフセットシャドウ言語）。しっぽは二重三角で枠線風に */
  .q-title {
    display: inline-block; position: relative;
    background: #fff; border: 2px solid var(--navy); border-radius: 14px; padding: 12px 26px;
    box-shadow: 5px 5px 0 var(--blue-pale);
    font-family: var(--font-round); font-weight: 900; font-size: clamp(19px, 4.6vw, 24px);
    color: var(--navy); margin: 0;
  }
  .q-title::after {
    content: ""; position: absolute; left: 50%; bottom: -12px; transform: translateX(-50%);
    border-left: 10px solid transparent; border-right: 10px solid transparent;
    border-top: 12px solid var(--navy);
  }
  .q-title::before {
    content: ""; position: absolute; left: 50%; bottom: -8px; transform: translateX(-50%);
    border-left: 8px solid transparent; border-right: 8px solid transparent;
    border-top: 9px solid #fff; z-index: 1;
  }
  /* 各柱 */
  .pillar { background: #fff; }
  .pillar.alt { background: var(--alt-bg); }
  .head { text-align: center; margin-bottom: 22px; }
  .pillar-pill {
    display: inline-block; font: 800 12.5px var(--font-round); letter-spacing: .18em;
    color: #fff; background: var(--orange); border-radius: 999px; padding: 6px 18px;
  }
  h2 { font-family: var(--font-round); font-weight: 900; font-size: clamp(21px, 3vw, 26px); color: var(--ink); margin: 12px 0 0; }

  /* 方眼ノート地カード（トップのMethodと同モチーフ） */
  .note-card {
    background-color: #fff;
    background-image:
      linear-gradient(rgba(74, 122, 204, .10) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 122, 204, .10) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--line); border-radius: 16px; padding: clamp(20px, 3.5vw, 32px);
    box-shadow: 0 1px 2px rgba(20, 42, 84, .06), 0 12px 24px rgba(20, 42, 84, .06);
  }
  .body-p { font-size: 15px; line-height: 2.15; color: var(--ink); margin: 0 auto 14px; max-width: 640px; }
  .body-p:last-of-type { margin-bottom: 0; }

  /* 授業料への導線 */
  .next { background: #fff; }
  .next-c { display: flex; justify-content: center; padding-top: clamp(28px, 4vw, 40px); padding-bottom: clamp(40px, 6vw, 56px); }
  .btn-out {
    display: flex; align-items: center; justify-content: center; min-width: 200px; gap: 8px;
    border: 2px solid var(--navy); color: var(--navy); background: #fff;
    font-size: 15px; font-weight: 700; padding: 14px 32px; border-radius: 999px; text-decoration: none;
  }
</style>
