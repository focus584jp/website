---
// ✗⇄◯比較のインデックスタブ図解。サイト共通の比較UI（旧BeforeAfterSlider・旧TargetTabsを統合。2026-08-15）。
// variant: 'blocks'=積み木（バラバラ→基礎から組み上がる。トップMethod・/method POINT01）
//          'talk'=Teaching vs Coaching の対話図（トップMethod・/method POINT02）
//          'target'=ターゲットの絞り込み（大勢→照準ロック。/price お手頃価格のワケ）
// 挙動: 画面に6割入ると✗→◯を1回だけ自動再生（4秒後）。以降はタブで切替（タップで自動再生はキャンセル）。
// タブは選択で寸法を変えず色だけ遷移（シームレス）。フォーカス側は常に大きめのインデックス。
// 切替時は要素が時間差で遷移する振り付け（積み木は下段→中段→上段→キラキラの順に組み上がる）。
// CSS transform(scale)がSVGのtranslate属性を上書きする問題は、位置決めを親gに分離するか inline style + !important で回避
interface Props { variant: 'blocks' | 'talk' | 'target' }
const { variant } = Astro.props;

const copy = {
  blocks: {
    ngHead: '無理に学校の進度に合わせると…',
    okHead: 'フォーカスでの成績の上がり方',
    ngNote: '土台が不安定で、<br>成績が伸びなやむ',
    okNote: '基礎から順番に積み上げて、<br><span class="mk">苦手を克服！</span>',
  },
  talk: {
    ngHead: '従来の塾の学習スタイル',
    okHead: 'フォーカスの学習スタイル',
    ngNote: '解き方を一方的に解説し、<br>生徒が受け身で聞くだけになる指導',
    okNote: '考え方を問いかけ、ヒントを与え、<br>「できた！」にたどり着かせる指導',
  },
  target: {
    ngHead: '全学年・全レベルに対応する塾',
    okHead: '勉強が苦手な中学生専門の塾',
    ngNote: '幅広く対応するため、<br>設備・教材・人件費などがかさむ',
    okNote: '対象を絞っているから、<br>ムダなコストがかからない',
  },
}[variant];

// blocks: 積み木（x, y, 段, Before姿勢のtransform）。
// Beforeは「基礎が固まっていない不安定な塔」: 基礎が不揃いで、上の段ほど大きく落ち込み傾いている。
// 切替時は全ブロックが一斉に正位置へ動く（時間差なし）＝落ちていた上段が持ち上がる動きが主役
// ※基礎を1個抜いて転がす案は試作の結果ボツ（瓦礫の山に見え「抜けた」と読めない。2026-08-16）
const blocks: [number, number, 1 | 2 | 3, string][] = [
  [28, 104, 1, 'translate(-9px, 2px) rotate(-6deg)'],
  [66, 104, 1, 'translate(-3px, 4px) rotate(3deg)'],
  [104, 104, 1, 'translate(3px, -3px) rotate(-8deg)'],
  [142, 104, 1, 'translate(10px, 2px) rotate(6deg)'],
  [47, 66, 2, 'translate(-9px, 20px) rotate(-14deg)'],
  [85, 66, 2, 'translate(2px, 24px) rotate(11deg)'],
  [123, 66, 2, 'translate(9px, 18px) rotate(-15deg)'],
  [66, 28, 3, 'translate(-12px, 34px) rotate(-20deg)'],
  // 一番上の右ブロックは地面まで落ちてひし形に挟まっている（旧スライダーで好評だった表現。切替時に最も大きく持ち上がる主役）
  [104, 28, 3, 'translate(14px, 66px) rotate(45deg)'],
];

// target: 群衆の配置（x, y, scale, target?）
const crowd: [number, number, number, boolean?][] = [
  [24, 12, .55], [62, 8, .7], [100, 14, .6], [140, 9, .72], [178, 13, .6], [214, 10, .55],
  [38, 60, .72], [76, 64, .62], [112, 58, .85, true], [148, 58, .85, true], [186, 62, .7], [220, 64, .58],
];
---
<div class="tw" data-cmp-tabs>
  <div class="tabs" role="tablist" aria-label="一般的な塾とフォーカスの比較切替">
    <button type="button" class="tab ng on" role="tab" aria-selected="true">一般的な塾</button>
    <button type="button" class="tab ok" role="tab" aria-selected="false">フォーカス</button>
  </div>
  <div class="card">
    <div class="sw">
      <p class="hd v-ng">{copy.ngHead}</p>
      <p class="hd v-ok">{copy.okHead}</p>
    </div>
    <div class="fig">
      {variant === 'blocks' && (
        <svg viewBox="-16 -9 242 176" role="img" aria-label="バラバラに散らばった積み木が、基礎から順番に積み上がっていく比較図">
          <ellipse cx="105" cy="139" rx="92" ry="9" fill="#2B3242" opacity=".13"></ellipse>
          {blocks.map(([x, y, row, pose]) => (
            <rect class={`blk r${row} pose`} style={`transform: ${pose}`} x={x} y={y} width="34" height="34" rx="2"></rect>
          ))}
          {/* グラグラ線: 不安定な土台の両脇に配置（塔の上ではなく基礎が震えている表現） */}
          <g class="deco only-b" stroke="#4A4F58" stroke-width="2.6" fill="none" stroke-linejoin="miter" stroke-linecap="butt">
            <path d="M26 74 l-8 6 4 9 -8 6 4 9"></path>
            <path d="M14 70 l-8 6 4 9 -8 6 4 9"></path>
          </g>
          <g class="deco only-b" stroke="#4A4F58" stroke-width="2.6" fill="none" stroke-linejoin="miter" stroke-linecap="butt">
            <path d="M190 74 l8 6 -4 9 8 6 -4 9"></path>
            <path d="M202 68 l8 6 -4 9 8 6 -4 9"></path>
          </g>
          <g fill="#FFC94A">
            <g transform="translate(48,34)"><path class="deco only-a spark-b" d="M0 -9 Q1.6 -1.6 9 0 Q1.6 1.6 0 9 Q-1.6 1.6 -9 0 Q-1.6 -1.6 0 -9 Z"></path></g>
            <g transform="translate(160,22)"><path class="deco only-a spark-b" d="M0 -6 Q1.2 -1.2 6 0 Q1.2 1.2 0 6 Q-1.2 1.2 -6 0 Q-1.2 -1.2 0 -6 Z"></path></g>
            <g transform="translate(172,54)"><path class="deco only-a spark-b" d="M0 -5 Q1 -1 5 0 Q1 1 0 5 Q-1 1 -5 0 Q-1 -1 0 -5 Z"></path></g>
          </g>
        </svg>
      )}
      {variant === 'talk' && (
        <svg viewBox="0 0 240 120" role="img" aria-label="一方的に教える従来の指導が、問いかけと回答をやり取りするフォーカスの指導に変わる比較図">
          <g class="person"><circle cx="45" cy="37" r="15"></circle><path d="M19 84 a26 26 0 0 1 52 0 Z"></path></g>
          <text class="plabel" x="45" y="103" text-anchor="middle" font-size="11.5" font-weight="700">先生</text>
          <g class="person"><circle cx="195" cy="42" r="12.5"></circle><path d="M174 84 a21 21 0 0 1 42 0 Z"></path></g>
          <text class="plabel" x="195" y="103" text-anchor="middle" font-size="11.5" font-weight="700">生徒</text>
          <g class="deco only-b">
            <path d="M86 62 h72" stroke="#8A96A8" stroke-width="3" stroke-linecap="round" fill="none"></path>
            <path d="M158 62 l-9 -6 m9 6 l-9 6" stroke="#8A96A8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
            <text x="122" y="50" text-anchor="middle" font-family="'Zen Maru Gothic',sans-serif" font-size="13" font-weight="900" fill="#5B6B85">教える</text>
          </g>
          <g class="deco only-a arr-q">
            <path d="M86 52 h72" stroke="#E67832" stroke-width="2.6" stroke-linecap="round" fill="none"></path>
            <path d="M158 52 l-8 -5 m8 5 l-8 5" stroke="#E67832" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
            <text x="122" y="42" text-anchor="middle" font-size="11" font-weight="700" fill="#E67832">問いかけ</text>
          </g>
          <g class="deco only-a arr-a">
            <path d="M158 70 h-72" stroke="#143778" stroke-width="2.6" stroke-linecap="round" fill="none"></path>
            <path d="M86 70 l8 -5 m-8 5 l8 5" stroke="#143778" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
            <text x="122" y="86" text-anchor="middle" font-size="11" font-weight="700" fill="#143778">回答</text>
          </g>
          <g class="deco only-a spark2">
            <path d="M216 20 v-8 M224 24 l6 -6 M226 32 h8" stroke="#FFC94A" stroke-width="3" stroke-linecap="round" fill="none"></path>
          </g>
        </svg>
      )}
      {variant === 'target' && (
        <svg viewBox="0 0 240 134" role="img" aria-label="全学年・全レベルの大勢の生徒から、勉強が苦手な中学生だけに照準が絞られる比較図">
          {crowd.map(([x, y, s, tgt]) =>
            tgt ? (
              <g transform={`translate(${x},${y}) scale(${s})`}>
                <g class="tp"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
              </g>
            ) : (
              <g class="np" transform={`translate(${x},${y}) scale(${s})`}><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
            )
          )}
          <g class="scope">
            <circle cx="130" cy="78" r="36" fill="none" stroke="#E67832" stroke-width="2.5" stroke-dasharray="6 5"></circle>
            <path d="M130 34 v12 M130 110 v12 M84 78 h12 M164 78 h12" stroke="#E67832" stroke-width="2.5" stroke-linecap="round"></path>
          </g>
          <g fill="#FFC94A">
            <g transform="translate(86,36)"><path class="deco only-a spark-t1" d="M0 -7 Q1.3 -1.3 7 0 Q1.3 1.3 0 7 Q-1.3 1.3 -7 0 Q-1.3 -1.3 0 -7 Z"></path></g>
            <g transform="translate(178,44)"><path class="deco only-a spark-t1" d="M0 -5 Q1 -1 5 0 Q1 1 0 5 Q-1 1 -5 0 Q-1 -1 0 -5 Z"></path></g>
          </g>
        </svg>
      )}
    </div>
    <div class="sw">
      <p class="nt v-ng" set:html={copy.ngNote} />
      <p class="nt v-ok" set:html={copy.okNote} />
    </div>
  </div>
</div>

<style>
  .tw { max-width: 440px; margin: clamp(14px, 2vw, 20px) auto 0; }

  /* インデックスタブ（ネイビー塗りつぶし）: 選択中=ブランド紺 / 非選択=薄いブルーグレー */
  .tabs { display: flex; gap: 8px; padding: 0 10px; position: relative; z-index: 1; margin-bottom: -2px; align-items: flex-end; }
  .tab {
    flex: 1; border: none; border-bottom: 2px solid transparent; border-radius: 12px 12px 0 0;
    background: #AEBDD2; color: #fff; cursor: pointer;
    padding: 9px 6px 10px;
    font: 800 13.5px var(--font-round);
    transition: background .25s ease, border-bottom-color .25s ease;
  }
  .tab.ok { flex: 1.5; font-size: 15px; padding-top: 11px; }
  .tab.ng.on { background: #76859B; }
  .tab.ok.on { background: var(--navy); }
  .tw:not(.st-ok) .tab:not(.on) { border-bottom-color: #DFE5EC; }
  .tw.st-ok .tab:not(.on) { border-bottom-color: var(--navy); }

  /* カード: ✗=グレー地 ⇄ ◯=淡青地+紺枠 */
  .card {
    border-radius: 14px; padding: 16px 12px 18px;
    display: flex; flex-direction: column; gap: 8px;
    background: #EEF1F5; border: 2px solid #DFE5EC;
    box-shadow: 0 3px 10px rgba(43, 50, 66, .08);
    transition: background .35s ease, border-color .35s ease, box-shadow .35s ease;
  }
  .tw.st-ok .card { background: var(--blue-paler); border-color: var(--navy); box-shadow: 0 4px 12px rgba(20, 42, 84, .10); }

  /* ✗⇄◯で切り替わる見出し・注釈は同セルに重ねてクロスフェード */
  .sw { display: grid; }
  .sw > * { grid-area: 1 / 1; transition: opacity .3s ease; margin: 0; }
  .tw.st-ok .v-ng { opacity: 0; }
  .tw:not(.st-ok) .v-ok { opacity: 0; }
  .hd { text-align: center; font-family: var(--font-round); font-size: 14.5px; font-weight: 800; }
  .hd.v-ng { color: var(--ink); }
  .hd.v-ok { color: var(--navy); }
  .nt { text-align: center; font-size: 14.5px; font-weight: 800; color: var(--ink); line-height: 1.8; }
  .nt.v-ok { color: var(--navy); }
  .fig svg { width: 100%; height: auto; display: block; }

  /* Before/After共通の飾り */
  .deco { transition: opacity .25s ease, transform .3s ease; transform-box: fill-box; transform-origin: center; }
  .only-b { opacity: 1; }
  .tw.st-ok .only-b { opacity: 0; }
  .only-a { opacity: 0; transform: scale(.4); }
  .tw.st-ok .only-a { opacity: 1; transform: scale(1); }

  /* --- blocks: 落ちていた上段ごと、全ブロックが一斉に正位置へ --- */
  .blk {
    transform-box: fill-box; transform-origin: center;
    transition: fill .3s ease, transform .45s cubic-bezier(.34, 1.45, .64, 1);
  }
  .r1 { fill: #7E8A9C; } .tw.st-ok .r1 { fill: var(--navy); }
  .r2 { fill: #96A1B1; } .tw.st-ok .r2 { fill: var(--navy-mid); }
  .r3 { fill: #ACB6C4; } .tw.st-ok .r3 { fill: var(--navy-light); }
  /* Before姿勢はinline style。◯で正位置へ（!importantでinlineを上書き） */
  .tw.st-ok .pose { transform: none !important; }
  .tw.st-ok .spark-b { transition-delay: .3s; }

  /* --- talk: 教える消滅→紺化→問いかけ→回答→ひらめき（テンポ速め） --- */
  .person { fill: #8A96A8; transition: fill .3s ease; }
  .tw.st-ok .person { fill: var(--navy); }
  .plabel { fill: #5B6B85; transition: fill .3s ease; }
  .tw.st-ok .plabel { fill: var(--navy); }
  .tw.st-ok .arr-q { transition-delay: .12s; }
  .tw.st-ok .arr-a { transition-delay: .24s; }
  .tw.st-ok .spark2 { transition-delay: .34s; }

  /* --- target: 対象外は薄く、ターゲットは紺+ズームイン、照準ポップ --- */
  .np { fill: #9FB3D1; transition: opacity .35s ease; }
  .tw.st-ok .np { opacity: .16; }
  .tp { fill: #9FB3D1; transition: fill .3s ease, transform .35s cubic-bezier(.34, 1.45, .64, 1); transform-box: fill-box; transform-origin: center; }
  .tw.st-ok .tp { fill: var(--navy); transform: scale(1.1); }
  .scope { opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(.55); transition: opacity .3s ease, transform .35s cubic-bezier(.34, 1.45, .64, 1); }
  .tw.st-ok .scope { opacity: 1; transform: scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .tab, .card, .sw > *, .blk, .deco, .person, .plabel, .np, .tp, .scope { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cmp-tabs]').forEach((box) => {
    const tabs = box.querySelectorAll<HTMLButtonElement>('.tab');
    const set = (ok: boolean) => {
      box.classList.toggle('st-ok', ok);
      tabs.forEach((t) => {
        const active = t.classList.contains('ok') === ok;
        t.classList.toggle('on', active);
        t.setAttribute('aria-selected', String(active));
      });
    };
    // 自動再生のタイマー: 手動タップで必ずキャンセル
    let autoTimer = 0;
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        clearTimeout(autoTimer);
        box.dataset.played = '1';
        set(t.classList.contains('ok'));
      }),
    );
    // 画面に6割入ったら1回だけ ✗→◯ を自動再生。
    // ✗側の見出し+注釈（40〜50字）を読み終えられるよう4秒見せてから切り替える（1.8秒では早すぎた）
    new IntersectionObserver((entries, ob) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !box.dataset.played) {
          box.dataset.played = '1';
          autoTimer = window.setTimeout(() => set(true), 4000);
          ob.disconnect();
        }
      });
    }, { threshold: 0.6 }).observe(box);
  });
</script>
