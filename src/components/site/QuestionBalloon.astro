---
// ページ導入の問いかけ吹き出し（保護者の疑問を代弁し、以降のセクションが答える構造）。/method・/price で共用。
// 白地+紺枠+紺文字+淡青のずらし影（ヒーローの専門タグと同じオフセットシャドウ言語）。しっぽは二重三角で枠線風
interface Props { text: string }
const { text } = Astro.props;
---
<section class="qb">
  <div class="container">
    <h2 class="q-title" set:html={text} />
  </div>
</section>

<style>
  .qb { background: #fff; }
  .container {
    max-width: 860px; margin: 0 auto; text-align: center;
    padding: clamp(32px, 5vw, 48px) 24px;
  }
  .q-title {
    display: inline-block; position: relative;
    /* 枠はHPの大きい文字に合わせて太め（スマホ2.5px・パソコン3px。パンフレットは文字が小さいので2px。2026-10-08 ユーザー指示） */
    --bw: 2.5px;
    background: #fff; border: var(--bw) solid var(--navy); border-radius: 14px; padding: 12px 26px;
    box-shadow: 5px 5px 0 var(--blue-pale);
    font-family: var(--font-round); font-weight: 900; font-size: clamp(19px, 4.6vw, 24px);
    color: var(--navy); margin: 0;
  }
  .q-title::after {
    content: ""; position: absolute; left: 50%; bottom: -12px; transform: translateX(-50%);
    border-left: 11px solid transparent; border-right: 11px solid transparent;
    border-top: 13px solid var(--navy);
  }
  .q-title::before {
    content: ""; position: absolute; left: 50%; bottom: calc(-13px + var(--bw) * 1.9); transform: translateX(-50%);
    border-left: 8px solid transparent; border-right: 8px solid transparent;
    border-top: 9.5px solid #fff; z-index: 1;
  }
  @media (min-width: 768px) { .q-title { --bw: 3px; } }
</style>
