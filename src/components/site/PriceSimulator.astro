---
// 料金シミュレータ（/price 授業料セクション用）。
// 本棚の教科書をタップすると選択がトグルし、「6,578円 × n教科（月4n回）」の式と月額合計を表示する。
// 「どの教科も同じ料金」「単純合算の明朗会計」を触って体験してもらう部品。
const subjects = [
  { label: '国語', color: '#B0413E' },
  { label: '数学', color: '#2C55A0' },
  { label: '英語', color: '#B95A1E' },
  { label: '理科', color: '#1F6B3C' },
  { label: '社会', color: '#6B4FA3' },
];
---
<div class="sim" data-price-sim>
  <p class="sim-q">受講を検討している教科を<br />選んでください</p>
  <div class="shelf">
    {subjects.map((s, i) => (
      <button type="button" class:list={['book', { on: i === 1 }]} style={`--bc: ${s.color}`} aria-pressed={i === 1 ? 'true' : 'false'}>
        {s.label}<span class="bmark" aria-hidden="true"></span>
      </button>
    ))}
  </div>
  <div class="board" aria-hidden="true"></div>
  <div class="sim-result">
    <p class="sim-formula" data-formula></p>
    <p class="sim-price" data-price></p>
  </div>
</div>

<style>
  /* 枠なし: 方眼ノートカードに直接置く（青枠+薄青地カードは2026-08-14に廃止） */
  .sim { max-width: 480px; margin: 14px auto 0; text-align: center; }
  .sim-q { font-family: var(--font-round); font-size: 17px; font-weight: 800; color: var(--navy); margin: 0 0 14px; line-height: 1.6; }

  /* 本棚: フラットな図案（ベタ塗り+帯ライン+ロゴ風マーク+棚板）で本を表す。立体表現は使わない */
  .shelf { display: flex; justify-content: center; align-items: flex-end; gap: 8px; }
  .book {
    position: relative; width: 49px; height: 92px; border: none; cursor: pointer; padding: 0;
    border-radius: 6px 6px 4px 4px;
    background: #DFE6EF; color: var(--gray-1);
    font: 800 14px var(--font-round);
    writing-mode: vertical-rl; text-orientation: upright; letter-spacing: .14em;
    display: flex; align-items: center; justify-content: center;
    transition: background .18s ease, color .18s ease, transform .18s ease, box-shadow .18s ease;
  }
  .book.on { background: var(--bc); color: #fff; transform: translateY(-9px); box-shadow: 0 4px 0 rgba(20, 42, 84, .16); }
  .book::after {
    content: ""; position: absolute; left: 7px; right: 7px; top: 9px; height: 2px; pointer-events: none;
    background: rgba(255, 255, 255, .65); box-shadow: 0 4px 0 rgba(255, 255, 255, .65);
  }
  .book .bmark { position: absolute; left: 7px; right: 7px; bottom: 20px; height: 2px; pointer-events: none; background: rgba(255, 255, 255, .65); }
  .book .bmark::after {
    content: ""; position: absolute; left: 50%; bottom: -14px; transform: translateX(-50%);
    width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, .8);
  }
  .board { height: 8px; margin: 0 22px; border-radius: 4px; background: #B9C8DE; }

  .sim-result { margin-top: 14px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 14px 12px 16px; }
  .sim-formula { font-size: 15px; font-weight: 700; color: var(--muted); margin: 0; font-variant-numeric: tabular-nums; }
  .sim-price { margin: 3px 0 0; line-height: 1.1; }
  .sim-price :global(.yen-l) { font: 700 17px var(--font-round); color: var(--ink); margin-right: 3px; }
  .sim-price :global(.n) { font: 900 clamp(40px, 9.5vw, 48px) var(--font-round); color: var(--orange); font-variant-numeric: tabular-nums; }
  .sim-price :global(.yen) { font: 700 18px var(--font-round); color: var(--ink); margin-left: 2px; }
  .sim-price :global(.tax) { font-size: 12px; color: var(--muted); margin-left: 3px; }
  .sim-price :global(.sim-empty) { display: inline-block; font-size: 14px; font-weight: 700; color: var(--gray-1); margin: 10px 0; }

  @media (prefers-reduced-motion: reduce) {
    .book { transition: none; }
    .book.on { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-price-sim]').forEach((sim) => {
    const books = sim.querySelectorAll<HTMLButtonElement>('.book');
    const formula = sim.querySelector('[data-formula]') as HTMLElement;
    const price = sim.querySelector('[data-price]') as HTMLElement;
    const UNIT = 6578;
    const LESSONS = 4; // 1教科あたり月4回
    const render = () => {
      const n = sim.querySelectorAll('.book.on').length;
      if (n === 0) {
        formula.textContent = '';
        price.innerHTML = '<span class="sim-empty">教科を選んでください</span>';
        return;
      }
      formula.textContent = `6,578円 × ${n}教科（月${LESSONS * n}回）`;
      const total = (UNIT * n).toLocaleString('ja-JP');
      price.innerHTML = `<span class="yen-l">月</span><span class="n">${total}</span><span class="yen">円</span><span class="tax">（税込）</span>`;
    };
    books.forEach((book) => {
      book.addEventListener('click', () => {
        const on = book.classList.toggle('on');
        book.setAttribute('aria-pressed', String(on));
        render();
      });
    });
    render();
  });
</script>
