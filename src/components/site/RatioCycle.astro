---
// 指導方針③「講師1人に、生徒は最大4人」の図（/method 専用）。デジタルパンフレットの fig_ratio と同じ形・同じ動き（2026-10-08 ユーザー指示で差し替え）。
// 講師（青）が4席を順に回り、回ってきた席は「解説」（青の枠・机の線が淡い青）、ほかの席は「演習」（机の橙の点線が動く＝自分で解いている）。
// 動きはCSSだけ（8秒で1周）。画面に入っているときだけ動く。prefers-reduced-motion では止めて、1席目が解説中の状態にする。
// 人のしるしは頭の半径5・肩の半径9・首のすき間1.5（パンフレットの person() と同じ比率）
const person = (x: number, y: number, s: number) =>
  `<circle cx="${x}" cy="${y}" r="${(5 * s).toFixed(1)}"/><path d="M${(x - 9 * s).toFixed(1)} ${(y + 15.5 * s).toFixed(1)}a${(9 * s).toFixed(1)} ${(9 * s).toFixed(1)} 0 0 1 ${(18 * s).toFixed(1)} 0z"/>`;
const seats = [0, 1, 2, 3].map((i) => ({ i, x: 16 + i * 82, delay: `${2 * i - 8}s` }));
---
<div class="rc" data-ratio-cycle>
  <svg viewBox="0 -8 342 140" role="img" aria-label="講師が4人の生徒を順に回り、解説と演習をくり返す図">
    {seats.map((s) => (
      <g class:list={['seat', `d${s.i}`]}>
        <rect class="glow" x={s.x - 6} y="36" width="76" height="76" rx="12" style={`animation-delay:${s.delay}`} />
        <g class="kid" set:html={person(s.x + 32, 56, 1.5)} />
        <rect class="desk" x={s.x} y="78" width="64" height="28" rx="6" />
        <path class="pen" d={`M${s.x + 16} 92h32`} style={`animation-delay:0s,${s.delay}`} />
        <path class="pen-s" d={`M${s.x + 16} 92h32`} style={`animation-delay:${s.delay}`} />
        <text class="t-ex" x={s.x + 32} y="126" style={`animation-delay:${s.delay}`}>解説</text>
        <text class="t-pr" x={s.x + 32} y="126" style={`animation-delay:${s.delay}`}>演習</text>
      </g>
    ))}
    <g class="teacher" set:html={person(48, 5, 1.6)} />
  </svg>
</div>

<style>
  /* 方眼ノートに直置き（サイト共通ルール: 状態切替UI以外の図解はパネルで囲まない。2026-08-15統一） */
  .rc { width: 100%; max-width: 440px; margin: clamp(18px, 2.5vw, 24px) auto 0; box-sizing: border-box; }
  .rc svg { width: 100%; height: auto; display: block; overflow: visible; }
  .desk { fill: #fff; stroke: var(--navy-soft); stroke-width: 1.5; }
  .kid { fill: var(--navy); }
  .teacher { fill: var(--navy-light); animation: rc-walk 8s cubic-bezier(.22, .68, .18, 1) infinite; }
  .glow { fill: none; stroke: var(--navy-light); stroke-width: 2.5; opacity: 0; animation: rc-lit 8s linear infinite; }
  .t-ex { font-size: 13.5px; font-weight: 800; text-anchor: middle; fill: var(--navy-mid); opacity: 0; animation: rc-lit 8s linear infinite; }
  .t-pr { font-size: 13.5px; font-weight: 800; text-anchor: middle; fill: var(--orange-shadow); animation: rc-unlit 8s linear infinite; }
  .pen, .pen-s { fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-dasharray: 3 3; }
  .pen { stroke: var(--orange); animation: rc-dash .9s linear infinite, rc-unlit 8s linear infinite; }
  .pen-s { stroke: var(--navy-soft); opacity: 0; animation: rc-lit 8s linear infinite; }
  @keyframes rc-walk { 0%, 20% { transform: translateX(0); } 25%, 45% { transform: translateX(82px); } 50%, 70% { transform: translateX(164px); } 75%, 95% { transform: translateX(246px); } 100% { transform: translateX(0); } }
  @keyframes rc-lit { 0%, 22% { opacity: 1; } 25%, 97% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes rc-unlit { 0%, 22% { opacity: 0; } 25%, 97% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes rc-dash { to { stroke-dashoffset: -12; } }
  /* 画面の外では止めておく */
  .rc:not(.run) * { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .rc * { animation: none !important; }
    .d0 .glow, .d0 .t-ex, .d0 .pen-s { opacity: 1; }
    .d0 .t-pr, .d0 .pen { opacity: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ratio-cycle]').forEach((fig) => {
    new IntersectionObserver((es) => es.forEach((e) => fig.classList.toggle('run', e.isIntersecting)), { threshold: 0.3 }).observe(fig);
  });
</script>
