---
// 指導方針③「講師1人に、生徒は最大4人」の巡回アニメ図解（/method 専用）。
// 先生が4席を順に回り（1→2→3→4→1…と循環）、いる席だけ「解説」（オレンジ机・紺生徒）、
// 他の席は「演習」に戻る。画面内にあるときだけ動く。prefers-reduced-motion では静止（2席目で解説中）。
---
<div class="rc" data-ratio-cycle>
  <svg viewBox="0 0 340 168" role="img" aria-label="講師1人が4人の生徒の席を順に回り、演習と解説を繰り返す授業の図">
    {/* 4席（机+生徒）。data-seat の順に先生が巡回する */}
    <g class="seat" data-seat="0">
      <rect class="desk" x="16" y="88" width="66" height="12" rx="3"></rect>
      <circle class="stu" cx="49" cy="116" r="10"></circle>
      <path class="stu" d="M32 148 a17 17 0 0 1 34 0 Z"></path>
      <text class="slabel" x="49" y="163" text-anchor="middle" font-size="10.5">演習</text>
    </g>
    <g class="seat" data-seat="1">
      <rect class="desk" x="90" y="88" width="66" height="12" rx="3"></rect>
      <circle class="stu" cx="123" cy="116" r="10"></circle>
      <path class="stu" d="M106 148 a17 17 0 0 1 34 0 Z"></path>
      <text class="slabel" x="123" y="163" text-anchor="middle" font-size="10.5">演習</text>
    </g>
    <g class="seat" data-seat="2">
      <rect class="desk" x="164" y="88" width="66" height="12" rx="3"></rect>
      <circle class="stu" cx="197" cy="116" r="10"></circle>
      <path class="stu" d="M180 148 a17 17 0 0 1 34 0 Z"></path>
      <text class="slabel" x="197" y="163" text-anchor="middle" font-size="10.5">演習</text>
    </g>
    <g class="seat" data-seat="3">
      <rect class="desk" x="238" y="88" width="66" height="12" rx="3"></rect>
      <circle class="stu" cx="271" cy="116" r="10"></circle>
      <path class="stu" d="M254 148 a17 17 0 0 1 34 0 Z"></path>
      <text class="slabel" x="271" y="163" text-anchor="middle" font-size="10.5">演習</text>
    </g>
    {/* 先生（seat 0 の位置が基準。JSが translateX で巡回させる） */}
    <g class="teacher" data-teacher>
      <circle cx="49" cy="26" r="13" fill="#143778"></circle>
      <path d="M27 66 a22 22 0 0 1 44 0 Z" fill="#143778"></path>
      <path d="M49 72 v14" stroke="#E67832" stroke-width="3" stroke-linecap="round"></path>
      <text x="78" y="34" font-size="11" font-weight="700" fill="#143778">先生</text>
    </g>
  </svg>
  <p class="cap">先生が順番に回り、<span class="mk">「演習」と「解説」を行き来</span>します</p>
</div>

<style>
  .rc { width: 100%; max-width: 420px; margin: clamp(14px, 2vw, 20px) auto 0; }
  .rc svg { width: 100%; height: auto; display: block; }
  .teacher { transition: transform .6s cubic-bezier(.45, 0, .25, 1); }
  .desk { transition: fill .45s ease; fill: #C6D0DC; }
  .stu { transition: fill .45s ease; fill: var(--gray-1); }
  .slabel { transition: fill .45s ease; fill: var(--muted); font-weight: 700; }
  .seat.active .desk { fill: #F6C9A8; }
  .seat.active .stu { fill: var(--navy); }
  .seat.active .slabel { fill: var(--orange); font-weight: 800; }
  .cap {
    font-size: 14.5px; font-weight: 700; color: var(--ink); line-height: 1.8;
    text-align: center; margin: 10px 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .teacher, .desk, .stu, .slabel { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ratio-cycle]').forEach((fig) => {
    const teacher = fig.querySelector('[data-teacher]') as SVGGElement;
    const seats = fig.querySelectorAll<SVGGElement>('.seat');
    const SEAT_STEP = 74; // 席の間隔（viewBox座標）
    let idx = 1;
    const setActive = (i: number) => {
      seats.forEach((s, j) => {
        const active = j === i;
        s.classList.toggle('active', active);
        s.querySelector('.slabel')!.textContent = active ? '解説' : '演習';
      });
    };
    teacher.style.transform = `translateX(${idx * SEAT_STEP}px)`;
    setActive(idx);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // 画面内にあるときだけ巡回（移動0.6s→到着した席だけ解説、1→2→3→4→1…と循環）
    let timer: ReturnType<typeof setInterval> | null = null;
    let arrive: ReturnType<typeof setTimeout> | null = null;
    const tick = () => {
      idx = (idx + 1) % seats.length;
      setActive(-1);
      teacher.style.transform = `translateX(${idx * SEAT_STEP}px)`;
      arrive = setTimeout(() => setActive(idx), 600);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !timer) {
          timer = setInterval(tick, 1700);
        } else if (!e.isIntersecting && timer) {
          clearInterval(timer);
          if (arrive) clearTimeout(arrive);
          timer = null;
          setActive(idx);
        }
      });
    }, { threshold: 0.3 });
    io.observe(fig);
  });
</script>
