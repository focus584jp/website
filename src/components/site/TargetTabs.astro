---
// お手頃価格のワケ図解（/price用）: ターゲット絞り込みのインデックスタブ切替。
// ✗「全学年・全レベルに対応する塾」⇄ ◯「勉強が苦手な中学生専門の塾」。
// 画面に入ると✗→◯を1回だけ自動再生し、以降はタブで切替。
// タブは選択で寸法を変えず色だけ遷移（シームレス）。フォーカス側は常に大きめのインデックス。
// 非選択タブの下辺にはカードの枠線と同色の線を通し、選択タブだけがカードに開いて見える。
// ターゲット2人はCSS transform(scale)がtranslate属性を上書きしないよう、位置決めを親gに分離（積み木キラキラと同じ対策）

// 群衆の配置（x, y, scale, target?）
const crowd: [number, number, number, boolean?][] = [
  [24, 12, .55], [62, 8, .7], [100, 14, .6], [140, 9, .72], [178, 13, .6], [214, 10, .55],
  [38, 60, .72], [76, 64, .62], [112, 58, .85, true], [148, 58, .85, true], [186, 62, .7], [220, 64, .58],
];
---
<div class="tw" data-target-tabs>
  <div class="tabs" role="tablist" aria-label="一般的な塾とフォーカスの比較切替">
    <button type="button" class="tab ng on" role="tab" aria-selected="true">一般的な塾</button>
    <button type="button" class="tab ok" role="tab" aria-selected="false">フォーカス</button>
  </div>
  <div class="card">
    <div class="sw">
      <p class="hd v-ng">全学年・全レベルに対応する塾</p>
      <p class="hd v-ok">勉強が苦手な中学生専門の塾</p>
    </div>
    <div class="fig">
      <svg viewBox="0 0 240 134" role="img" aria-label="全学年・全レベルの大勢の生徒から、勉強が苦手な中学生だけに照準が絞られる比較図">
        {crowd.map(([x, y, s, tgt]) =>
          tgt ? (
            <g transform={`translate(${x},${y}) scale(${s})`}>
              <g class="tp"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
            </g>
          ) : (
            <g class="np" transform={`translate(${x},${y}) scale(${s})`}><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
          )
        )}
        <g class="scope">
          <circle cx="130" cy="78" r="36" fill="none" stroke="#E67832" stroke-width="2.5" stroke-dasharray="6 5"></circle>
          <path d="M130 34 v12 M130 110 v12 M84 78 h12 M164 78 h12" stroke="#E67832" stroke-width="2.5" stroke-linecap="round"></path>
        </g>
        <g fill="#FFC94A">
          <g transform="translate(86,36)"><path class="spark" d="M0 -7 Q1.3 -1.3 7 0 Q1.3 1.3 0 7 Q-1.3 1.3 -7 0 Q-1.3 -1.3 0 -7 Z"></path></g>
          <g transform="translate(178,44)"><path class="spark" d="M0 -5 Q1 -1 5 0 Q1 1 0 5 Q-1 1 -5 0 Q-1 -1 0 -5 Z"></path></g>
        </g>
      </svg>
    </div>
    <div class="sw">
      <p class="nt v-ng">幅広く対応するため、<br />設備・教材・人件費がかさむ</p>
      <p class="nt v-ok">対象を絞っているから、<br />ムダなコストがかからない</p>
    </div>
  </div>
</div>

<style>
  .tw { max-width: 440px; margin: clamp(14px, 2vw, 20px) auto 0; }

  /* インデックスタブ（ネイビー塗りつぶし）: 選択中=ブランド紺 / 非選択=薄いブルーグレー */
  .tabs { display: flex; gap: 8px; padding: 0 10px; position: relative; z-index: 1; margin-bottom: -2px; align-items: flex-end; }
  .tab {
    flex: 1; border: none; border-bottom: 2px solid transparent; border-radius: 12px 12px 0 0;
    background: #AEBDD2; color: #fff; cursor: pointer;
    padding: 9px 6px 10px;
    font: 800 13.5px var(--font-round);
    transition: background .25s ease, border-bottom-color .25s ease;
  }
  .tab.ok { flex: 1.5; font-size: 15px; padding-top: 11px; }
  .tab.ng.on { background: #76859B; }
  .tab.ok.on { background: var(--navy); }
  .tw:not(.st-ok) .tab:not(.on) { border-bottom-color: #DFE5EC; }
  .tw.st-ok .tab:not(.on) { border-bottom-color: var(--navy); }

  /* カード: ✗=グレー地 ⇄ ◯=淡青地+紺枠（スライダーと同じ言語） */
  .card {
    border-radius: 14px; padding: 16px 12px 18px;
    display: flex; flex-direction: column; gap: 8px;
    background: #EEF1F5; border: 2px solid #DFE5EC;
    box-shadow: 0 3px 10px rgba(43, 50, 66, .08);
    transition: background .35s ease, border-color .35s ease, box-shadow .35s ease;
  }
  .tw.st-ok .card { background: var(--blue-paler); border-color: var(--navy); box-shadow: 0 4px 12px rgba(20, 42, 84, .10); }

  /* ✗⇄◯で切り替わる見出し・注釈は同セルに重ねてクロスフェード */
  .sw { display: grid; }
  .sw > * { grid-area: 1 / 1; transition: opacity .3s ease; margin: 0; }
  .tw.st-ok .v-ng { opacity: 0; }
  .tw:not(.st-ok) .v-ok { opacity: 0; }
  .hd { text-align: center; font-family: var(--font-round); font-size: 14.5px; font-weight: 800; }
  .hd.v-ng { color: var(--ink); }
  .hd.v-ok { color: var(--navy); }
  .nt { text-align: center; font-size: 14.5px; font-weight: 800; color: var(--ink); line-height: 1.8; }
  .nt.v-ok { color: var(--navy); }

  /* 図の下端（照準の下の余白）に注釈を少し食い込ませ、図と注釈の間延びを防ぐ */
  .fig { margin-bottom: -14px; }
  .fig svg { width: 100%; height: auto; display: block; }
  /* 対象外は薄く、ターゲットは紺+ややズームイン */
  .np { fill: #9FB3D1; transition: opacity .35s ease; }
  .tw.st-ok .np { opacity: .16; }
  .tp { fill: #9FB3D1; transition: fill .3s ease, transform .35s cubic-bezier(.34, 1.45, .64, 1); transform-box: fill-box; transform-origin: center; }
  .tw.st-ok .tp { fill: var(--navy); transform: scale(1.1); }
  /* 照準とキラキラは◯状態でポップイン */
  .scope { opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(.55); transition: opacity .3s ease, transform .35s cubic-bezier(.34, 1.45, .64, 1); }
  .tw.st-ok .scope { opacity: 1; transform: scale(1); }
  .spark { opacity: 0; transition: opacity .3s ease .12s; }
  .tw.st-ok .spark { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .tab, .card, .sw > *, .np, .tp, .scope, .spark { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-target-tabs]').forEach((box) => {
    const tabs = box.querySelectorAll<HTMLButtonElement>('.tab');
    const set = (ok: boolean) => {
      box.classList.toggle('st-ok', ok);
      tabs.forEach((t) => {
        const active = t.classList.contains('ok') === ok;
        t.classList.toggle('on', active);
        t.setAttribute('aria-selected', String(active));
      });
    };
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        box.dataset.played = '1';
        set(t.classList.contains('ok'));
      }),
    );
    // 画面に入ったら1回だけ ✗→◯ を自動再生（以降は手動）
    new IntersectionObserver((entries, ob) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !box.dataset.played) {
          box.dataset.played = '1';
          setTimeout(() => set(true), 1200);
          ob.disconnect();
        }
      });
    }, { threshold: 0.6 }).observe(box);
  });
</script>
