---
// 指導方針④「選び抜かれた千葉大生講師陣」のフィルター図解（/method 専用）。
// 左=講師に応募した千葉大生10人 → 中央=厳しい選考プロセス（紺ヘッダー帯カード+審査項目3つ）
// → 右=採用3人（上1・下2のピラミッド配置）+ 採用率 約30%。
---
<div class="tf">
  <span class="badge">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"></path><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"></path></svg>
    千葉大学の講師のみ在籍
  </span>
  <svg viewBox="0 0 380 236" role="img" aria-label="講師に応募した千葉大生10人が、寄り添う姿勢・責任感・指導スキルを見る厳しい選考を経て、約30%の3人だけがフォーカスの講師になる図">
    {/* 左: 講師に応募した千葉大生10人（2列×5行・薄紺） */}
    <text class="t-sub" x="52" y="14" text-anchor="middle" font-size="11" font-weight="800">千葉大生の応募</text>
    <g class="applicants">
      <g transform="translate(32,28) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(72,28) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(32,64) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(72,64) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(32,100) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(72,100) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(32,136) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(72,136) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(32,172) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(72,172) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
    </g>
    {/* 収束線: 応募者が選考へ絞り込まれる */}
    <g class="lines">
      <path d="M92 44 L118 96"></path>
      <path d="M92 80 L118 104"></path>
      <path d="M92 116 L118 112"></path>
      <path d="M92 152 L118 120"></path>
      <path d="M92 188 L118 128"></path>
    </g>
    {/* 中央: 厳しい選考プロセスのカード（紺ヘッダー帯） */}
    <rect class="card-bg" x="120" y="40" width="140" height="148" rx="14"></rect>
    <path class="card-head" d="M120 54 a14 14 0 0 1 14 -14 h112 a14 14 0 0 1 14 14 v22 h-140 Z"></path>
    <text x="190" y="62" text-anchor="middle" font-size="13" font-weight="800" fill="#fff">厳しい選考プロセス</text>
    {/* 審査項目3つ（淡青丸+紺チェック） */}
    <g class="check-item">
      <circle cx="146" cy="103" r="10"></circle>
      <path d="M141 103 l3.5 3.5 7 -7.5"></path>
      <text x="164" y="108" font-size="12" font-weight="800">寄り添う姿勢</text>
    </g>
    <g class="check-item">
      <circle cx="146" cy="135" r="10"></circle>
      <path d="M141 135 l3.5 3.5 7 -7.5"></path>
      <text x="164" y="140" font-size="12" font-weight="800">責任感</text>
    </g>
    <g class="check-item">
      <circle cx="146" cy="165" r="10"></circle>
      <path d="M141 165 l3.5 3.5 7 -7.5"></path>
      <text x="164" y="170" font-size="12" font-weight="800">指導スキル</text>
    </g>
    {/* 出口の矢印 */}
    <g class="arrow">
      <path d="M266 106 h18"></path>
      <path d="M284 106 l-7 -5.5 m7 5.5 l-7 5.5"></path>
    </g>
    {/* 右: 採用3人（上1・下2のピラミッド配置）+ 約30% */}
    <text class="t-navy" x="330" y="14" text-anchor="middle" font-size="11" font-weight="800">フォーカスの講師</text>
    <g class="hired">
      <g transform="translate(330,30) scale(.78)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(306,78) scale(.78)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(354,78) scale(.78)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
    </g>
    <text class="t-ink" x="330" y="154" text-anchor="middle" font-size="12" font-weight="800">採用率</text>
    <text class="t-rate" x="330" y="188" text-anchor="middle" font-weight="900"><tspan font-size="17">約</tspan><tspan font-size="34">30</tspan><tspan font-size="18">%</tspan></text>
  </svg>
</div>

<style>
  .tf {
    margin: clamp(14px, 2vw, 20px) auto 0; max-width: 400px;
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .tf > svg { width: 100%; height: auto; display: block; }
  .badge {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--navy); color: #fff; border-radius: 999px; padding: 7px 16px;
    font-family: var(--font-round); font-size: 13.5px; font-weight: 800;
  }
  .t-sub { fill: var(--muted); }
  .t-navy { fill: var(--navy); }
  .t-ink { fill: var(--ink); }
  .t-rate { fill: var(--orange); font-family: var(--font-round); }
  .applicants { fill: #9FB3D1; }
  .hired { fill: var(--navy); }
  .lines path { stroke: #C9D4E2; stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .card-bg { fill: #fff; stroke: var(--navy); stroke-width: 2; }
  .card-head { fill: var(--navy); }
  .check-item circle { fill: #E3ECFB; }
  .check-item path { stroke: var(--navy); stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .check-item text { fill: var(--ink); }
  .arrow path { stroke: var(--orange); stroke-width: 4.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
