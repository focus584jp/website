---
// 指導方針④「選び抜かれた千葉大生講師陣」のフィルター図解（/method 専用）。
// 左=講師に応募した千葉大生10人 → 中央=厳しい選考プロセス（紺ヘッダー帯カード+審査項目3つ）
// → 右=採用3人（上1・下2のピラミッド配置）+ 採用率 約30%。
---
<div class="tf">
  <svg viewBox="0 0 388 240" role="img" aria-label="講師に応募した千葉大生10人が、寄り添う姿勢・責任感・指導スキルを見る厳しい選考を経て、約30%の3人だけがフォーカスの講師になる図">
    {/* 左: 講師に応募した千葉大生10人（2列×5行・薄紺） */}
    <text class="t-sub" x="50" y="15" text-anchor="middle" font-size="13" font-weight="800">千葉大生の応募</text>
    <g class="applicants">
      <g transform="translate(28,30) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(66,30) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(28,66) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(66,66) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(28,102) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(66,102) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(28,138) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(66,138) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(28,174) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(66,174) scale(.66)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
    </g>
    {/* 収束線: 応募者が選考へ絞り込まれる */}
    <g class="lines">
      <path d="M84 46 L110 98"></path>
      <path d="M84 82 L110 106"></path>
      <path d="M84 118 L110 114"></path>
      <path d="M84 154 L110 122"></path>
      <path d="M84 190 L110 130"></path>
    </g>
    {/* 中央: 厳しい選考プロセスのカード（紺ヘッダー帯） */}
    <rect class="card-bg" x="112" y="38" width="154" height="152" rx="14"></rect>
    <path class="card-head" d="M112 52 a14 14 0 0 1 14 -14 h126 a14 14 0 0 1 14 14 v24 h-154 Z"></path>
    <text x="189" y="63" text-anchor="middle" font-size="15" font-weight="800" fill="#fff">厳しい選考プロセス</text>
    {/* 審査項目3つ（淡青丸+紺チェック） */}
    <g class="check-item">
      <circle cx="138" cy="104" r="10.5"></circle>
      <path d="M133 104 l3.5 3.5 7.5 -8"></path>
      <text x="156" y="109" font-size="13.5" font-weight="800">寄り添う姿勢</text>
    </g>
    <g class="check-item">
      <circle cx="138" cy="136" r="10.5"></circle>
      <path d="M133 136 l3.5 3.5 7.5 -8"></path>
      <text x="156" y="141" font-size="13.5" font-weight="800">責任感</text>
    </g>
    <g class="check-item">
      <circle cx="138" cy="168" r="10.5"></circle>
      <path d="M133 168 l3.5 3.5 7.5 -8"></path>
      <text x="156" y="173" font-size="13.5" font-weight="800">指導スキル</text>
    </g>
    {/* 出口の矢印 */}
    <g class="arrow">
      <path d="M272 108 h16"></path>
      <path d="M288 108 l-7 -5.5 m7 5.5 l-7 5.5"></path>
    </g>
    {/* 右: 採用3人（上1・下2のピラミッド配置）+ 約30% */}
    <text class="t-navy" x="334" y="15" text-anchor="middle" font-size="12.5" font-weight="800">フォーカスの講師</text>
    <g class="hired">
      <g transform="translate(334,32) scale(.8)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(310,80) scale(.8)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
      <g transform="translate(358,80) scale(.8)"><circle cx="0" cy="14" r="8"></circle><path d="M-14 40 a14 14 0 0 1 28 0 Z"></path></g>
    </g>
    <text class="t-ink" x="334" y="160" text-anchor="middle" font-size="13.5" font-weight="800">採用率</text>
    <text class="t-rate" x="334" y="196" text-anchor="middle" font-weight="900"><tspan font-size="18">約</tspan><tspan font-size="36">30</tspan><tspan font-size="19">%</tspan></text>
  </svg>
</div>

<style>
  /* 淡青パネルで図解エリアを区切る（①②のスライダーカードに合わせた見せ方） */
  .tf {
    margin: clamp(14px, 2vw, 20px) auto 0; max-width: 440px;
    background: var(--blue-paler); border-radius: 14px; padding: 20px 14px 16px;
    box-sizing: border-box;
  }
  .tf > svg { width: 100%; height: auto; display: block; }
  .t-sub { fill: var(--muted); }
  .t-navy { fill: var(--navy); }
  .t-ink { fill: var(--ink); }
  .t-rate { fill: var(--orange); font-family: var(--font-round); }
  .applicants { fill: #9FB3D1; }
  .hired { fill: var(--navy); }
  .lines path { stroke: #C9D4E2; stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .card-bg { fill: #fff; stroke: var(--navy); stroke-width: 2; }
  .card-head { fill: var(--navy); }
  .check-item circle { fill: #E3ECFB; }
  .check-item path { stroke: var(--navy); stroke-width: 2.4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .check-item text { fill: var(--ink); }
  .arrow path { stroke: var(--orange); stroke-width: 4.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
</style>
