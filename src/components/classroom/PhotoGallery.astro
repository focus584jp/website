---
// 教室風景ギャラリー: サムネのグリッド＋タップで拡大（ライトボックス）。
// 拡大中は 画像タップ/左右矢印/スワイプ で前後移動（端はループ）、背景タップ/✕/Esc で閉じる。
// 写真が無い教室はダミータイルを表示する（src/assets/classrooms/<slug>/ への実写真投入で自動切り替え）。
// ダミー時もタイルはタップ可能で、サンプル画像（SVG）でライトボックスの挙動を確認できる。
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props { photos: ImageMetadata[]; captions?: string[]; roomName: string }
const { photos, captions = [], roomName } = Astro.props;
// 写真ごとの説明（captions.json）。足りない分は「様子N」で埋める
const cap = (i: number) => captions[i] ?? `様子${i + 1}`;

// 拡大表示用の大きめ最適化画像（サムネとは別に幅1200で生成）
const fullImages = await Promise.all(photos.map((p) => getImage({ src: p, width: 1200 })));

// ダミー時の拡大用サンプル画像（SVGをdata URIで埋め込み。実写真投入で使われなくなる）
const isPlaceholder = photos.length === 0;
const PH_COUNT = 4;
const phFull = (i: number) =>
  'data:image/svg+xml;utf8,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="900">` +
      `<rect width="1200" height="900" fill="#EEF1F6"/>` +
      `<rect x="24" y="24" width="1152" height="852" rx="20" fill="none" stroke="#C9D2DE" stroke-width="4" stroke-dasharray="14 12"/>` +
      `<svg x="540" y="330" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="#8A96A8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>` +
      `<text x="600" y="540" text-anchor="middle" font-family="Hiragino Kaku Gothic ProN, sans-serif" font-size="40" font-weight="700" fill="#8A96A8">写真準備中（サンプル ${i + 1}）</text>` +
    `</svg>`,
  );
const count = isPlaceholder ? PH_COUNT : photos.length;
---
  <div class="gallery" data-lbx-root data-name={roomName} data-ph={isPlaceholder ? '1' : null}>
    {isPlaceholder
      ? [...Array(PH_COUNT).keys()].map((i) => (
          <button type="button" class="th th-ph" data-full={phFull(i)} aria-label={`写真準備中のサンプル${i + 1}を拡大表示`}>
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
            <span>写真準備中</span>
          </button>
        ))
      : photos.map((p, i) => (
          <button type="button" class="th" data-full={fullImages[i].src} data-w={fullImages[i].attributes.width} data-h={fullImages[i].attributes.height} data-desc={cap(i)} aria-label={`${roomName} ${cap(i)}を拡大表示`}>
            <Image src={p} alt={`${roomName} ${cap(i)}`} widths={[400, 800]} sizes="(min-width: 768px) 25vw, 50vw" class="photo" />
            <span class="zoom" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
            </span>
          </button>
        ))}
    {!isPlaceholder && (
      <p class="hint">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
        写真をタップすると拡大できます
      </p>
    )}

    <div class="lbx" role="dialog" aria-modal="true" aria-label={`${roomName}の写真の拡大表示`} data-lbx>
      <div class="ov" data-close></div>
      <figure class="fig">
        <img class="big" data-big alt="" decoding="async" />
        <button type="button" class="ctl x" data-close aria-label="閉じる">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
        <figcaption class="cp"><span class="num" data-num></span><span data-cap></span></figcaption>
      </figure>
      {count > 1 && (
        <>
          <button type="button" class="ctl lnav prev" data-prev aria-label="前の写真へ">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="ctl lnav next" data-next aria-label="次の写真へ">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </>
      )}
    </div>
  </div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  @media (min-width: 768px) { .gallery { grid-template-columns: repeat(4, 1fr); } }

  .th { position: relative; padding: 0; border: 0; background: none; display: block; border-radius: 14px; cursor: zoom-in; }
  .th:active .photo { transform: scale(.97); }
  .photo { transition: transform .12s ease; }
  /* 「拡大できる」合図: 右下の白丸バッジ（スマホはhoverが無いので常時表示） */
  .zoom {
    position: absolute; right: 8px; bottom: 8px; width: 24px; height: 24px;
    border-radius: 50%; background: rgba(20, 30, 50, .45); color: #fff;
    display: grid; place-items: center; pointer-events: none;
  }
  .zoom svg { width: 13px; height: 13px; }
  .hint {
    grid-column: 1 / -1; margin: 2px 0 0; display: flex; align-items: center; justify-content: center; gap: 6px;
    font-size: 12px; font-weight: 600; color: var(--gray-1);
  }
  .th:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }
  /* height:auto は必須: astro:assets の <Image> が height 属性を出すため、無いと aspect-ratio が無視されて縦長に崩れる */
  .photo { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; display: block; }

  /* ダミータイル（タップでサンプル画像のライトボックスが開く） */
  .th-ph {
    aspect-ratio: 4 / 3; background: var(--panel);
    border: 1px dashed var(--line); color: var(--gray-1);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  }
  .th-ph span { font-family: var(--font-body); font-size: 12px; font-weight: 600; }

  /* ライトボックス（固定CTAの z-index:60 より前面に） */
  .lbx {
    position: fixed; inset: 0; z-index: 100; padding: 20px;
    display: none; align-items: center; justify-content: center;
  }
  .lbx.is-open { display: flex; }
  .ov { position: absolute; inset: 0; background: rgba(16, 24, 34, .8); animation: lbx-fade .28s ease; }
  .fig {
    position: relative; margin: 0; max-width: 900px;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    animation: lbx-zoom .28s ease;
  }
  .big {
    max-width: 100%; height: auto; max-height: 70vh; max-height: 70dvh; border-radius: 14px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, .45);
    cursor: pointer; touch-action: none; user-select: none; -webkit-user-select: none;
  }
  /* 説明文: 画像の直下。画像には width/height を渡してあるので読み込み前から位置が確定し、写真と重ならない */
  .cp {
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
    padding: 0 8px; color: #fff; font-size: 13.5px; font-weight: 700; letter-spacing: .03em; text-align: center;
  }
  .num { font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: rgba(255, 255, 255, .18); }

  .ctl {
    position: absolute; z-index: 1; width: 40px; height: 40px; padding: 0;
    border: none; border-radius: 50%; cursor: pointer;
    background: rgba(255, 255, 255, .94); color: var(--navy);
    display: grid; place-items: center; box-shadow: 0 2px 10px rgba(0, 0, 0, .35);
  }
  .x { top: -14px; right: -12px; } /* 画像の右上角に重ねる（.figが画像幅にフィットする前提） */
  .lnav { top: 50%; transform: translateY(-50%); }
  .prev { left: 10px; }
  .next { right: 10px; }

  @keyframes lbx-fade { from { opacity: 0; } }
  @keyframes lbx-zoom { from { opacity: 0; transform: scale(.88); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lbx-root]').forEach((root) => {
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.th')];
    const box = root.querySelector<HTMLElement>('[data-lbx]');
    const big = root.querySelector<HTMLImageElement>('[data-big]');
    const cap = root.querySelector<HTMLElement>('[data-cap]');
    const num = root.querySelector<HTMLElement>('[data-num]');
    if (!box || !big || !cap || !num || thumbs.length === 0) return;

    const fulls = thumbs.map((t) => t.dataset.full ?? '');
    const dims = thumbs.map((t) => [Number(t.dataset.w) || 0, Number(t.dataset.h) || 0] as const);
    const caps = thumbs.map((t) => t.dataset.desc ?? '');
    const name = root.dataset.name ?? '';
    const isPh = root.dataset.ph === '1'; // ダミー（サンプル画像）モード
    const n = fulls.length;
    let idx = 0;
    let opener: HTMLElement | null = null;

    function render() {
      const [w, h] = dims[idx];
      if (w && h) { big!.width = w; big!.height = h; } // 読み込み前に比率を確定（レイアウトのガタつき防止）
      big!.src = fulls[idx];
      num!.textContent = `${idx + 1} / ${n}`;
      cap!.textContent = isPh ? '写真準備中（サンプル）' : caps[idx];
      if (n > 1) new Image().src = fulls[(idx + 1) % n]; // 次の1枚を先読み
    }
    const next = () => { idx = (idx + 1) % n; render(); };
    const prev = () => { idx = (idx - 1 + n) % n; render(); };

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    }
    function open(i: number, from: HTMLElement | null) {
      idx = i;
      opener = from;
      render();
      box!.classList.add('is-open');
      document.body.style.overflow = 'hidden'; // 背面スクロールを止める
      document.addEventListener('keydown', onKey);
      box!.querySelector<HTMLElement>('.x')?.focus({ preventScroll: true });
    }
    function close() {
      box!.classList.remove('is-open');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      opener?.focus({ preventScroll: true });
    }

    thumbs.forEach((t, i) => t.addEventListener('click', () => open(i, t)));
    box.addEventListener('click', (e) => {
      const el = e.target as Element;
      if (el.closest('[data-close]')) close();
      else if (el.closest('[data-prev]')) prev();
      else if (el.closest('[data-next]')) next();
    });

    // 拡大画像: タップで次へ、スワイプで前後（スワイプ直後のclickは無視）
    let startX = 0;
    let swiped = false;
    big.addEventListener('pointerdown', (e) => { startX = e.clientX; swiped = false; });
    big.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (n > 1 && Math.abs(dx) > 50) {
        swiped = true;
        if (dx < 0) next(); else prev();
      }
    });
    big.addEventListener('click', () => { if (!swiped && n > 1) next(); });

    // DEV専用: ?lbx=<index> で自動オープン（実機確認用。本番ビルドでは除去される）
    if (import.meta.env.DEV) {
      const q = new URLSearchParams(location.search).get('lbx');
      if (q !== null) open(Math.min(Number(q) || 0, n - 1), null);
    }
  });
</script>
